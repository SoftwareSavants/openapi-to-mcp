{
  "name": "notion-api",
  "version": "1.0.0",
  "description": "MCP server for notion-api",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "start:http": "node --env-file=.env dist/index.js --http",
    "start:sse": "node --env-file=.env dist/index.js --sse",
    "dev": "tsx --env-file=.env src/index.ts",
    "dev:http": "tsx --env-file=.env src/index.ts --http",
    "dev:sse": "tsx --env-file=.env src/index.ts --sse"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}